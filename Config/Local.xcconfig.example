// Copy this file to Local.xcconfig and fill it in. Local.xcconfig is ignored
// by git, so your team and device never end up in the repository.

// Your Apple developer team ID: ten letters and digits, shown at
// developer.apple.com/account under Membership details, or in Xcode's
// Signing & Capabilities tab.
DEVELOPMENT_TEAM = ABCDE12345

// A bundle ID your team can sign. Apple allows each ID to one team only, so
// anyone but the app's owner needs their own.
APP_BUNDLE_ID = com.example.resident

// The phone ./run-device.sh installs to: a name or identifier from
// `xcrun devicectl list devices`.
RUN_DEVICE = My iPhone

// Optional. OAuth clients of your own, so GitHub and Google connect with one
// tap. GitHub: an OAuth app at github.com/settings/developers with the callback
// <your bundle ID>://oauth and Enable Device Flow ticked; no secret is needed.
// Google: an iOS OAuth client for your bundle ID. Neither ID is a secret.
// GITHUB_CLIENT_ID = Ov23abcdefghijklmnop
// GOOGLE_CLIENT_ID = 1234567890-abcdefg.apps.googleusercontent.com
