<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the app use more of the device's memory, which decides how large a model fits. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- Lets a long task started from Shortcuts keep the GPU while the app is not on screen, which a model run by the app needs. -->
	<key>com.apple.developer.background-tasks.continued-processing.gpu</key>
	<true/>
</dict>
</plist>
